{
  "printWidth": 140,
  "tabWidth": 4,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "arrowParens": "avoid",
  "bracketSpacing": true,
  "endOfLine": "auto",
  "plugins": ["./scripts/prettier/single-line-imports.mjs"],
  "overrides": [
    { "files": ["*.json", "*.yml", "*.yaml"], "options": { "tabWidth": 2 } }
  ]
}
