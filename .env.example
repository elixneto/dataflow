# Copy to .env at the root (not committed): the settings of docker-compose.yml. Dev values only.

# Postgres (the host port: change it when 5432 is taken by another Postgres)
POSTGRES_USER=dataflow
POSTGRES_PASSWORD=dataflow
POSTGRES_DB=dataflow
POSTGRES_PORT=5432

# the server in Docker (`docker compose --profile server up -d`); `npm run start` reads dataflow.server/.env instead
ENVIRONMENT=DEV
# workers the supervisor starts = runs executed at the same time (one worker = one run)
WORKERS=1
WORKER_TAGS=default
# keys that encrypt the secrets: empty in DEV (a fixed dev key, never for real data); required outside DEV
# SECRETS_KEYS=v1:<base64 of 32 bytes>
