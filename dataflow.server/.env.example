# Copy to dataflow.server/.env (Bun loads .env from the folder it runs in). dataflow.server/.env is not committed.
# Without DATABASE_URL the server uses PGlite in dataflow.server/data.local/.
# DATABASE_URL=postgres://dataflow:dataflow@localhost:5432/dataflow
ENVIRONMENT=DEV
API_PORT=5190
# workers the supervisor starts = runs executed at the same time on this machine (one worker = one run)
WORKERS=1
WORKER_TAGS=default
# PROMOTE_TO=https://cliente1-staging.dataflow.com
# keys that encrypt the secrets (AES-256-GCM); the last one encrypts, all decrypt (rotation). Required outside DEV;
# in DEV, without it, a fixed dev key is used (never for real data). New key: bun -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('base64'))"
# SECRETS_KEYS=v1:<base64 of 32 bytes>
