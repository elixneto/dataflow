{
  "name": "dataflow-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "imports": {
    "#components/*": ["./src/components/*.ts", "./src/components/*.tsx"],
    "#editor/*": ["./src/editor/*.ts", "./src/editor/*.tsx"],
    "#lib/*": ["./src/lib/*.ts", "./src/lib/*.tsx"],
    "#mock/*": ["./src/mock/*.ts", "./src/mock/*.tsx"],
    "#pages/*": ["./src/pages/*.ts", "./src/pages/*.tsx"],
    "#run/*": ["./src/run/*.ts", "./src/run/*.tsx"],
    "#types/*": ["./src/types/*.ts", "./src/types/*.tsx"],
    "#ui/*": ["./src/ui/*.ts", "./src/ui/*.tsx"]
  },
  "scripts": {
    "start": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.60.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  }
}
