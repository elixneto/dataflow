{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@dataflow/core": [
        "../core/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "../core/src"
  ],
  "exclude": [
    "../core/src/**/*.test.ts"
  ]
}