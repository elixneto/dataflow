{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["bun"],
    "baseUrl": ".",
    "paths": {"@dataflow/core": ["../core/src/index.ts"]}
  },
  "include": ["src", "../core/src"],
  "exclude": ["../core/src/**/*.test.ts"]
}
